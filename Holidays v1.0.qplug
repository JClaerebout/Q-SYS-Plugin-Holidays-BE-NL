---------------------------------- Controls -----------------------------------
function GetControls(props)
    local ctls = { 
		{
			Name = "HolidayStatus",
			Count = 1,
			ControlType = "Indicator",
			IndicatorType = "LED",
			UserPin = true,
			PinStyle = "Output",
		},
		{
			Name = "HolidayName",
			Count = 1,
            ControlType = "Indicator",
            IndicatorType = "Text",
            PinStyle = "Output",
            UserPin = true,
			PinStyle = "Output",
		},
		{
			Name = "DateInput",
			Count = 1,
            ControlType = "Text",
			DefaultValue = "1-1-2026",
			UserPin = false,
		},
		{
			Name = "Date",
			Count = 1,
			ControlType = "Indicator",
			IndicatorType = "Text",
			UserPin = false,
		},
		{
			Name = "HolidayToday",
			Count = 1,
			ControlType = "Indicator",
			IndicatorType = "Text",
			UserPin = false,
		},
	}
    -- figure out how many list entries we need based on the selected country
    local listCount = 12
    if props["Country"].Value == "Netherlands" then
        listCount = 10
    end
    table.insert(ctls, {
        Name = "HolidayEntry",
        Count = listCount,
        ControlType = "Indicator",
        IndicatorType = "Text",
        UserPin = true,
		PinStyle = "Output",
    })
    table.insert(ctls, {
        Name = "IgnoreBtn",
        Count = listCount,
        ControlType = "Button",
        ButtonType = "Toggle",
        UserPin = true,
		PinStyle = "Both",
    })

    return ctls
end

