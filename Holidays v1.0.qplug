------------------------------ Local Functions --------------------------------
function HEXtoDEC(hex)
	hex = string.upper(hex)
	local b1 = string.byte(string.sub(hex, 1, 1))
	local b2 = string.byte(string.sub(hex, 2, 2))
  
	return( (b1<=57 and b1-48 or b1-55)*16 + (b2<=57 and b2-48 or b2-55) )
end

function ConvertColor(c)
	local t = {}
	t[1] = HEXtoDEC(string.sub(c,2,3))
	t[2] = HEXtoDEC(string.sub(c,4,5))
	t[3] = HEXtoDEC(string.sub(c,6,7))
	return t
end

-- === HELPER FUNCTIONS ===
function easter_date(year)
    local a = year % 19
    local b = math.floor(year / 100)
    local c = year % 100
    local d = math.floor(b / 4)
    local e = b % 4
    local f = math.floor((b + 8) / 25)
    local g = math.floor((b - f + 1) / 3)
    local h = (19 * a + b - d - g + 15) % 30
    local i = math.floor(c / 4)
    local k = c % 4
    local l = (32 + 2 * e + 2 * i - h - k) % 7
    local m = math.floor((a + 11 * h + 22 * l) / 451)
    local month = math.floor((h + l - 7 * m + 114) / 31)
    local day = ((h + l - 7 * m + 114) % 31) + 1
    return day, month
end


-- return a table {day=<>,month=<>,year=<>} based on either the real clock
-- or the user-entered emulation date.  Also update the visible Date
-- indicator.
local function parse_input_date()
    local s = Controls.DateInput.String or ""
    -- trim whitespace around the string
    s = s:match("^%s*(.-)%s*$")
    -- allow spaces around the dashes as well
    local d,m,y = s:match("^(%d+)%s*%-%s*(%d+)%s*%-%s*(%d+)$")
    return tonumber(d), tonumber(m), tonumber(y)
end

function get_current_date()
    if Properties["Emulate"].Value then
        local d,m,y = parse_input_date()
        print("[DEBUG] Emulate mode active, input string='" .. (Controls.DateInput.String or "") .. "'")
        if d and m and y then
            print(string.format("[DEBUG] Parsed emulated date %d-%d-%d", d, m, y))
            Controls.Date.String = string.format("%d-%d-%d", d, m, y)
            return { day = d, month = m, year = y }
        else
            print("[DEBUG] Failed to parse emulated date, falling back to real clock")
        end
        -- malformed entry; fall through to real date
    end
    local t = os.date("*t")
    Controls.Date.String = string.format(t.day .. "-" .. t.month .. "-" .. t.year)
    return t
end

function is_today(day, month)
    local today = get_current_date()
    return today.day == day and today.month == month
end

function date_offset_from_easter(offset_days)
    local today = get_current_date()
    local year = tonumber(today.year)
    local day, month = easter_date(year)
    local easter = os.time{year = year, month = month, day = day, hour = 0, min = 0, sec = 0}
    local target = os.date("*t", easter + offset_days * 86400)
    return target.day, target.month, target.year
end

-- === MAIN FUNCTION ===
function get_sorted_holidays()
    -- return a list of {day, month, name} sorted by month/day for the current year
    local today = get_current_date()
    local year = tonumber(today.year)
    local list = {}

    -- fixed dates
    for _, datum in ipairs(holidays.fixed[country]) do
        table.insert(list, {day = datum[1], month = datum[2], name = datum[3]})
    end

    -- variable dates (based on easter)
    for _, offsetData in ipairs(holidays.variable[country]) do
        local offset, name = offsetData[1], offsetData[2]
        local d, m, y = date_offset_from_easter(offset)
        if y == year then
            table.insert(list, {day = d, month = m, name = name})
        end
    end

    table.sort(list, function(a, b)
        if a.month == b.month then
            return a.day < b.day
        end
        return a.month < b.month
    end)

	local entryCount = 12
	if Properties["Country"].Value == "Netherlands" then
		entryCount = 10
	end
	
	for i, item in ipairs(list) do
		if i <= entryCount then
			Controls.HolidayEntry[i].String = string.format("%02d - %s\t\t%s", item.day, months[item.month], item.name)
		end
	end

    return list
end

function holiday_info()
    -- return three values: isHoliday, name, ignoredFlag
    -- The name is returned regardless of the ignore state so the UI can still
    -- display it; only the boolean output should be suppressed when ignored.

    local today = get_current_date()
    local list = get_sorted_holidays()

    local entryCount = 12
    if Properties["Country"].Value == "Netherlands" then
        entryCount = 10
    end

    for i, item in ipairs(list) do
        if i > entryCount then
            break
        end
        if today.day == item.day and today.month == item.month then
            local ignored = false
            if Controls.IgnoreBtn and Controls.IgnoreBtn[i] then
                ignored = Controls.IgnoreBtn[i].Boolean
            end
            return true, item.name, ignored
        end
    end

    return false, "", false
end

-- === OUTPUT FUNCTION ===
function daily_check()
    local isHoliday, name, ignored = holiday_info()
    -- holiday indicator should be false when ignored, but we still report name
    Controls.HolidayStatus.Boolean = isHoliday and not ignored
    Controls.HolidayName.String = name ~= "" and name or "No Holiday"
    if isHoliday then
        Controls.HolidayToday.String = "Today is a holiday" .. (ignored and " (Ignored)" or "")
    else
        Controls.HolidayToday.String = "No holiday today."
    end
    print("Holiday:", isHoliday and name or "No Holiday", ignored and "(ignored)" or "")
end

------------------------------- Runtime Logic ---------------------------------

if Controls then
------------------------------------ Objects ----------------------------------

-------------------------------- Initialization -------------------------------
function Initialize()
	Timer = Timer or {}

	-- === CONFIG ===
	if Properties["Country"].Value=="Belgium" then
		country = "BE" 
	elseif Properties["Country"].Value=="Netherlands" then
		country = "NL" 
	end
	
	checkHour = 1  -- check every day at 01:00

	-- === HOLIDAY DEFINITIONS ===
	holidays = {
		fixed = {
			["BE"] = {
				{1, 1, "Nieuwjaar"},
				{1, 5, "Dag van de Arbeid"},
				{21, 7, "Nationale feestdag"},
				{15, 8, "O.L.V. Hemelvaart"},
				{1, 11, "Allerheiligen"},
				{11, 11, "Wapenstilstand"},
				{25, 12, "Kerstmis"},
			},
			["NL"] = {
				{1, 1, "Nieuwjaarsdag"},
				{27, 4, "Koningsdag"},
				{5, 5, "Bevrijdingsdag"},
				{25, 12, "Eerste Kerstdag"},
				{26, 12, "Tweede Kerstdag"},
			}
		},
		variable = {
			["BE"] = {
				{0, "Pasen"},
				{1, "Paasmaandag"},
				{39, "Hemelvaart"},
				{49, "Pinksteren"},
				{50, "Pinkstermaandag"},
			},
			["NL"] = {
				{0, "Pasen"},
				{1, "Paasmaandag"},
				{39, "Hemelvaart"},
				{49, "Pinksteren"},
				{50, "Pinkstermaandag"},
			}
		}
	}

	months = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}

	-- Initialize check
	daily_check()

	-- control input change handler
	Controls.DateInput.EventHandler = function()
		if Properties["Emulate"].Value then
			daily_check()
		end
	end

	-- === TIMER FOR DAILY CHECK ===
	lastCheckedDay = os.date("*t").day
	Timer.DayCheck = Timer.New()
	Timer.DayCheck:Start(60)  -- every minute

	Timer.DayCheck.EventHandler = function()
		local now = os.date("*t")
		if now.hour == checkHour and now.day ~= lastCheckedDay then
			lastCheckedDay = now.day
			daily_check()
		end
	end
end

local canInitialize = true

-- Check Properties and other stuff for illegal values

if canInitialize then
	print("Initializing")
	Initialize()
	print("Initialization Complete")
else
	print("Not initializing")
end

